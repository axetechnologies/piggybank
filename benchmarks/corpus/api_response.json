[{"sha":"b9e1a50005a9e64e6e87da5c7616ae031348f70e","node_id":"C_kwDOUCovadoAKGI5ZTFhNTAwMDVhOWU2NGU2ZTg3ZGE1Yzc2MTZhZTAzMTM0OGY3MGU","commit":{"author":{"name":"James Lewis","email":"james@virul.co","date":"2026-08-24T13:10:36Z"},"committer":{"name":"James Lewis","email":"james@virul.co","date":"2026-08-24T13:10:36Z"},"message":"MCP stdio server: boomerang mcp serve\n\nHand-rolled JSON-RPC 2.0 over stdio, no SDK, no async runtime - it's a\nblocking read-line/dispatch/write-line loop, which is the entire MCP\nstdio transport. Implements initialize, tools/list, tools/call, and\ncorrectly drops notifications (messages with no id get no response,\nper JSON-RPC).\n\nThree tools, named to mirror headroom's own MCP surface for a direct\ncomparison:\n  - boomerang_compress(content, key?) - auto-detects JSON (routes to\n    the lossless columnar compressor) vs text/logs (dedup+elision).\n    key enables session-aware diffing against whatever was last\n    compressed under that key.\n  - boomerang_retrieve(ref) - fetch exact original bytes for a\n    reference id embedded in a compressed view.\n  - boomerang_stats() - entries/bytes currently in the store.\n\nAdded Store::stats() to boomerang-core (filters to sha256-hex-named\nfiles so Session's .session.json sidecar doesn't get counted), tested.\n\nVerified against the actual protocol, not just unit tests: initialize\nhandshake, tools/list schema, and a full tools/call round trip - a\n300-line log auto-routed to kind:text, compressed 14679 -> 1396 bytes,\nthen boomerang_retrieve (a separate MCP call) pulled back the exact\n275 elided lines via its embedded ref.\n\nboomerang mcp serve [--store-dir <path>], defaults to\n~/.boomerang/store so a client-launched server has a stable persistent\nlocation regardless of launch cwd.","tree":{"sha":"61e9410b6eb635032a76c4260a32b5397f60d32d","url":"https://api.github.com/repos/memjar/boomerang/git/trees/61e9410b6eb635032a76c4260a32b5397f60d32d"},"url":"https://api.github.com/repos/memjar/boomerang/git/commits/b9e1a50005a9e64e6e87da5c7616ae031348f70e","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/memjar/boomerang/commits/b9e1a50005a9e64e6e87da5c7616ae031348f70e","html_url":"https://github.com/memjar/boomerang/commit/b9e1a50005a9e64e6e87da5c7616ae031348f70e","comments_url":"https://api.github.com/repos/memjar/boomerang/commits/b9e1a50005a9e64e6e87da5c7616ae031348f70e/comments","author":{"login":"memjar","id":139057878,"node_id":"U_kgDOCEna1g","avatar_url":"https://avatars.githubusercontent.com/u/139057878?v=4","gravatar_id":"","url":"https://api.github.com/users/memjar","html_url":"https://github.com/memjar","followers_url":"https://api.github.com/users/memjar/followers","following_url":"https://api.github.com/users/memjar/following{/other_user}","gists_url":"https://api.github.com/users/memjar/gists{/gist_id}","starred_url":"https://api.github.com/users/memjar/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/memjar/subscriptions","organizations_url":"https://api.github.com/users/memjar/orgs","repos_url":"https://api.github.com/users/memjar/repos","events_url":"https://api.github.com/users/memjar/events{/privacy}","received_events_url":"https://api.github.com/users/memjar/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"memjar","id":139057878,"node_id":"U_kgDOCEna1g","avatar_url":"https://avatars.githubusercontent.com/u/139057878?v=4","gravatar_id":"","url":"https://api.github.com/users/memjar","html_url":"https://github.com/memjar","followers_url":"https://api.github.com/users/memjar/followers","following_url":"https://api.github.com/users/memjar/following{/other_user}","gists_url":"https://api.github.com/users/memjar/gists{/gist_id}","starred_url":"https://api.github.com/users/memjar/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/memjar/subscriptions","organizations_url":"https://api.github.com/users/memjar/orgs","repos_url":"https://api.github.com/users/memjar/repos","events_url":"https://api.github.com/users/memjar/events{/privacy}","received_events_url":"https://api.github.com/users/memjar/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"fe7adaf55dcbdcf82d164c81ed64349af4d3dc7f","url":"https://api.github.com/repos/memjar/boomerang/commits/fe7adaf55dcbdcf82d164c81ed64349af4d3dc7f","html_url":"https://github.com/memjar/boomerang/commit/fe7adaf55dcbdcf82d164c81ed64349af4d3dc7f"}]},{"sha":"fe7adaf55dcbdcf82d164c81ed64349af4d3dc7f","node_id":"C_kwDOUCovadoAKGZlN2FkYWY1NWRjYmRjZjgyZDE2NGM4MWVkNjQzNDlhZjRkM2RjN2Y","commit":{"author":{"name":"James Lewis","email":"james@virul.co","date":"2026-08-24T12:58:56Z"},"committer":{"name":"James Lewis","email":"james@virul.co","date":"2026-08-24T12:58:56Z"},"message":"boomerang-core: Session — diff against what was last shown, per key\n\nsession.rs: hand-rolled LCS line differ (textbook O(N*M) DP, not Myers -\ndocumented as the one thing to swap if that ever matters) plus a Session\ntype that tracks, per caller-supplied key (e.g. a file path), the content\nid of whatever was last compressed under that key.\n\n  - First sight of a key: passthrough, nothing to diff against yet.\n  - Identical re-read: collapses to a single short reference marker.\n  - Changed: compact diff against the previous version, replayable via\n    decompress() against the stored old content to reconstruct the new\n    content exactly.\n\nSession::open() persists the key->id map to disk (.session.json next to\nthe store) so state survives process restarts - required for the CLI to\ndemonstrate this at all, since each invocation is a fresh process and an\nin-memory-only Session would look like 'first sight' every single time.\nSession::new() stays in-memory-only for embedding in a long-lived process\n(e.g. the MCP server, next).\n\nFactored the PUA marker/strip_pua helpers out of text.rs into a shared\nmarkers.rs so session.rs isn't duplicating them.\n\nVerified across separate CLI process invocations on a 200-line file:\nfirst sight 6380/6380 bytes, identical re-read 90 bytes, one-line edit\n238 vs 6400 bytes (96% smaller), decompression in a 4th separate process\nbyte-identical to the edited file (verified with cmp).\n\nAlso: added CI (fmt/clippy -D warnings/test/release build on push+PR).","tree":{"sha":"3aa09ae483ec2f910502c15130adb924c3d15361","url":"https://api.github.com/repos/memjar/boomerang/git/trees/3aa09ae483ec2f910502c15130adb924c3d15361"},"url":"https://api.github.com/repos/memjar/boomerang/git/commits/fe7adaf55dcbdcf82d164c81ed64349af4d3dc7f","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/memjar/boomerang/commits/fe7adaf55dcbdcf82d164c81ed64349af4d3dc7f","html_url":"https://github.com/memjar/boomerang/commit/fe7adaf55dcbdcf82d164c81ed64349af4d3dc7f","comments_url":"https://api.github.com/repos/memjar/boomerang/commits/fe7adaf55dcbdcf82d164c81ed64349af4d3dc7f/comments","author":{"login":"memjar","id":139057878,"node_id":"U_kgDOCEna1g","avatar_url":"https://avatars.githubusercontent.com/u/139057878?v=4","gravatar_id":"","url":"https://api.github.com/users/memjar","html_url":"https://github.com/memjar","followers_url":"https://api.github.com/users/memjar/followers","following_url":"https://api.github.com/users/memjar/following{/other_user}","gists_url":"https://api.github.com/users/memjar/gists{/gist_id}","starred_url":"https://api.github.com/users/memjar/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/memjar/subscriptions","organizations_url":"https://api.github.com/users/memjar/orgs","repos_url":"https://api.github.com/users/memjar/repos","events_url":"https://api.github.com/users/memjar/events{/privacy}","received_events_url":"https://api.github.com/users/memjar/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"memjar","id":139057878,"node_id":"U_kgDOCEna1g","avatar_url":"https://avatars.githubusercontent.com/u/139057878?v=4","gravatar_id":"","url":"https://api.github.com/users/memjar","html_url":"https://github.com/memjar","followers_url":"https://api.github.com/users/memjar/followers","following_url":"https://api.github.com/users/memjar/following{/other_user}","gists_url":"https://api.github.com/users/memjar/gists{/gist_id}","starred_url":"https://api.github.com/users/memjar/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/memjar/subscriptions","organizations_url":"https://api.github.com/users/memjar/orgs","repos_url":"https://api.github.com/users/memjar/repos","events_url":"https://api.github.com/users/memjar/events{/privacy}","received_events_url":"https://api.github.com/users/memjar/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"1d98d8b9a3550c0262ad0db07cd46bb5615f07b1","url":"https://api.github.com/repos/memjar/boomerang/commits/1d98d8b9a3550c0262ad0db07cd46bb5615f07b1","html_url":"https://github.com/memjar/boomerang/commit/1d98d8b9a3550c0262ad0db07cd46bb5615f07b1"}]},{"sha":"1d98d8b9a3550c0262ad0db07cd46bb5615f07b1","node_id":"C_kwDOUCovadoAKDFkOThkOGI5YTM1NTBjMDI2MmFkMGRiMDdjZDQ2YmI1NjE1ZjA3YjE","commit":{"author":{"name":"James Lewis","email":"james@virul.co","date":"2026-08-24T12:54:29Z"},"committer":{"name":"James Lewis","email":"james@virul.co","date":"2026-08-24T12:54:29Z"},"message":"add CI: fmt/clippy/test/release-build on every push and PR\n\ncargo fmt --check, clippy -D warnings, full test suite, release build,\nrunning on push to main and on PRs. Applied cargo fmt to get to a clean\nbaseline before wiring it up.","tree":{"sha":"ab4a58c95e88cc1cb39cdd3fc8f2e940d7bf73bd","url":"https://api.github.com/repos/memjar/boomerang/git/trees/ab4a58c95e88cc1cb39cdd3fc8f2e940d7bf73bd"},"url":"https://api.github.com/repos/memjar/boomerang/git/commits/1d98d8b9a3550c0262ad0db07cd46bb5615f07b1","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/memjar/boomerang/commits/1d98d8b9a3550c0262ad0db07cd46bb5615f07b1","html_url":"https://github.com/memjar/boomerang/commit/1d98d8b9a3550c0262ad0db07cd46bb5615f07b1","comments_url":"https://api.github.com/repos/memjar/boomerang/commits/1d98d8b9a3550c0262ad0db07cd46bb5615f07b1/comments","author":{"login":"memjar","id":139057878,"node_id":"U_kgDOCEna1g","avatar_url":"https://avatars.githubusercontent.com/u/139057878?v=4","gravatar_id":"","url":"https://api.github.com/users/memjar","html_url":"https://github.com/memjar","followers_url":"https://api.github.com/users/memjar/followers","following_url":"https://api.github.com/users/memjar/following{/other_user}","gists_url":"https://api.github.com/users/memjar/gists{/gist_id}","starred_url":"https://api.github.com/users/memjar/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/memjar/subscriptions","organizations_url":"https://api.github.com/users/memjar/orgs","repos_url":"https://api.github.com/users/memjar/repos","events_url":"https://api.github.com/users/memjar/events{/privacy}","received_events_url":"https://api.github.com/users/memjar/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"memjar","id":139057878,"node_id":"U_kgDOCEna1g","avatar_url":"https://avatars.githubusercontent.com/u/139057878?v=4","gravatar_id":"","url":"https://api.github.com/users/memjar","html_url":"https://github.com/memjar","followers_url":"https://api.github.com/users/memjar/followers","following_url":"https://api.github.com/users/memjar/following{/other_user}","gists_url":"https://api.github.com/users/memjar/gists{/gist_id}","starred_url":"https://api.github.com/users/memjar/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/memjar/subscriptions","organizations_url":"https://api.github.com/users/memjar/orgs","repos_url":"https://api.github.com/users/memjar/repos","events_url":"https://api.github.com/users/memjar/events{/privacy}","received_events_url":"https://api.github.com/users/memjar/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"341985d66f22720b5ea77da3b57d4ecac72d8d9e","url":"https://api.github.com/repos/memjar/boomerang/commits/341985d66f22720b5ea77da3b57d4ecac72d8d9e","html_url":"https://github.com/memjar/boomerang/commit/341985d66f22720b5ea77da3b57d4ecac72d8d9e"}]},{"sha":"341985d66f22720b5ea77da3b57d4ecac72d8d9e","node_id":"C_kwDOUCovadoAKDM0MTk4NWQ2NmYyMjcyMGI1ZWE3N2RhM2I1N2Q0ZWNhYzcyZDhkOWU","commit":{"author":{"name":"James Lewis","email":"james@virul.co","date":"2026-08-24T12:47:13Z"},"committer":{"name":"James Lewis","email":"james@virul.co","date":"2026-08-24T12:47:13Z"},"message":"boomerang-core: log/text compressor with lossy view + exact recovery\n\ncompress_text/decompress_text: the first real use of Store for genuinely\nlossy content.\n\n  - Consecutive-line dedup: N identical lines in a row -> 1 line + a\n    repeat marker, but only when the marker overhead actually pays for\n    itself (short lines / low repeat counts are left literal).\n  - Middle elision past a line-count threshold: keep head+tail, store the\n    exact original middle span in Store, splice in a reference marker.\n\ndecompress_text, given the same store, reconstructs the original exactly\n- that's the property under test, not just 'looks similar'. Non-UTF-8\ninput is stored whole and handled as a single reference rather than\nrejected.\n\nWired into the CLI as compress-log/decompress-log. Fixed a CLI-only bug\nalong the way: println! was appending a stray newline on top of content\nthat already ended in one, breaking the on-disk round trip despite the\nin-process assert_eq! round trip already passing - switched to raw\nstdout writes.\n\n25732 -> 2129 bytes (91.7%) on a synthetic 300-line log with a repeated\nFATAL burst, byte-identical after decompression (verified with cmp).","tree":{"sha":"12c8552c1b6b08d77cfe9bb7d76abc59d08cc51e","url":"https://api.github.com/repos/memjar/boomerang/git/trees/12c8552c1b6b08d77cfe9bb7d76abc59d08cc51e"},"url":"https://api.github.com/repos/memjar/boomerang/git/commits/341985d66f22720b5ea77da3b57d4ecac72d8d9e","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/memjar/boomerang/commits/341985d66f22720b5ea77da3b57d4ecac72d8d9e","html_url":"https://github.com/memjar/boomerang/commit/341985d66f22720b5ea77da3b57d4ecac72d8d9e","comments_url":"https://api.github.com/repos/memjar/boomerang/commits/341985d66f22720b5ea77da3b57d4ecac72d8d9e/comments","author":{"login":"memjar","id":139057878,"node_id":"U_kgDOCEna1g","avatar_url":"https://avatars.githubusercontent.com/u/139057878?v=4","gravatar_id":"","url":"https://api.github.com/users/memjar","html_url":"https://github.com/memjar","followers_url":"https://api.github.com/users/memjar/followers","following_url":"https://api.github.com/users/memjar/following{/other_user}","gists_url":"https://api.github.com/users/memjar/gists{/gist_id}","starred_url":"https://api.github.com/users/memjar/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/memjar/subscriptions","organizations_url":"https://api.github.com/users/memjar/orgs","repos_url":"https://api.github.com/users/memjar/repos","events_url":"https://api.github.com/users/memjar/events{/privacy}","received_events_url":"https://api.github.com/users/memjar/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"memjar","id":139057878,"node_id":"U_kgDOCEna1g","avatar_url":"https://avatars.githubusercontent.com/u/139057878?v=4","gravatar_id":"","url":"https://api.github.com/users/memjar","html_url":"https://github.com/memjar","followers_url":"https://api.github.com/users/memjar/followers","following_url":"https://api.github.com/users/memjar/following{/other_user}","gists_url":"https://api.github.com/users/memjar/gists{/gist_id}","starred_url":"https://api.github.com/users/memjar/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/memjar/subscriptions","organizations_url":"https://api.github.com/users/memjar/orgs","repos_url":"https://api.github.com/users/memjar/repos","events_url":"https://api.github.com/users/memjar/events{/privacy}","received_events_url":"https://api.github.com/users/memjar/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"29a53d6684a4b75aa52820188b77476d7f07bfe0","url":"https://api.github.com/repos/memjar/boomerang/commits/29a53d6684a4b75aa52820188b77476d7f07bfe0","html_url":"https://github.com/memjar/boomerang/commit/29a53d6684a4b75aa52820188b77476d7f07bfe0"}]},{"sha":"29a53d6684a4b75aa52820188b77476d7f07bfe0","node_id":"C_kwDOUCovadoAKDI5YTUzZDY2ODRhNGI3NWFhNTI4MjAxODhiNzc0NzZkN2YwN2JmZTA","commit":{"author":{"name":"James Lewis","email":"james@virul.co","date":"2026-08-24T12:41:29Z"},"committer":{"name":"James Lewis","email":"james@virul.co","date":"2026-08-24T12:41:29Z"},"message":"boomerang-core: content-addressed Store + lossless JSON columnar compressor\n\nStore: sha256-keyed blob store on disk, dedups by content, nothing ever\noverwritten. This is the primitive that makes compression reversible.\n\ncompress_json/decompress_json: homogeneous arrays of objects become a\ncolumnar table (keys once, rows of values) instead of repeating every\nkey per element. Fully lossless - proven by round-trip property tests,\nnot eyeballed. Doesn't touch Store yet; that's for the lossy log/diff\ncompressors that come next.\n\nboomerang-cli: minimal compress/decompress file CLI, no arg-parsing\nframework, for exercising the core by hand.","tree":{"sha":"d5471cbbd2038acb6b6d3b6eae9ea9ee003dc2a7","url":"https://api.github.com/repos/memjar/boomerang/git/trees/d5471cbbd2038acb6b6d3b6eae9ea9ee003dc2a7"},"url":"https://api.github.com/repos/memjar/boomerang/git/commits/29a53d6684a4b75aa52820188b77476d7f07bfe0","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/memjar/boomerang/commits/29a53d6684a4b75aa52820188b77476d7f07bfe0","html_url":"https://github.com/memjar/boomerang/commit/29a53d6684a4b75aa52820188b77476d7f07bfe0","comments_url":"https://api.github.com/repos/memjar/boomerang/commits/29a53d6684a4b75aa52820188b77476d7f07bfe0/comments","author":{"login":"memjar","id":139057878,"node_id":"U_kgDOCEna1g","avatar_url":"https://avatars.githubusercontent.com/u/139057878?v=4","gravatar_id":"","url":"https://api.github.com/users/memjar","html_url":"https://github.com/memjar","followers_url":"https://api.github.com/users/memjar/followers","following_url":"https://api.github.com/users/memjar/following{/other_user}","gists_url":"https://api.github.com/users/memjar/gists{/gist_id}","starred_url":"https://api.github.com/users/memjar/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/memjar/subscriptions","organizations_url":"https://api.github.com/users/memjar/orgs","repos_url":"https://api.github.com/users/memjar/repos","events_url":"https://api.github.com/users/memjar/events{/privacy}","received_events_url":"https://api.github.com/users/memjar/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"memjar","id":139057878,"node_id":"U_kgDOCEna1g","avatar_url":"https://avatars.githubusercontent.com/u/139057878?v=4","gravatar_id":"","url":"https://api.github.com/users/memjar","html_url":"https://github.com/memjar","followers_url":"https://api.github.com/users/memjar/followers","following_url":"https://api.github.com/users/memjar/following{/other_user}","gists_url":"https://api.github.com/users/memjar/gists{/gist_id}","starred_url":"https://api.github.com/users/memjar/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/memjar/subscriptions","organizations_url":"https://api.github.com/users/memjar/orgs","repos_url":"https://api.github.com/users/memjar/repos","events_url":"https://api.github.com/users/memjar/events{/privacy}","received_events_url":"https://api.github.com/users/memjar/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[]}]